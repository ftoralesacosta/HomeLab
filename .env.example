# Cloudflare Configuration
Cloudflare_API_KEY=your_api_key_here

# Wireguard Configuration
WIREGUARD_PRIVATE_KEY=your_private_key_here

# Authelia: Gmail app password for verification/reset emails (smtp.gmail.com:587)
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# CoreWeave / W&B Inference (Open WebUI, Hermes via systemd/hermes-env.service, Codex via ~/.bashrc)
COREWEAVE_API_BASE=https://api.inference.wandb.ai/v1
COREWEAVE_API_KEY=your_coreweave_api_key_here

# Open WebUI
WEBUI_SECRET_KEY=openssl_rand_hex_32
OAUTH_CLIENT_SECRET=authelia_oidc_client_secret_plaintext
# Hermes API server key (Open WebUI client + Hermes API_SERVER_KEY via systemd/hermes-env.service)
HERMES_API_KEY=openssl_rand_hex_32

# General / other services
DOMAIN_NAME=example.com
DOCKERDIR=/home/you/.volumes
WIREGUARD_ADDRESS=10.2.0.2/32
SEARXNG_SECRET=openssl_rand_hex_32

# Actual Budget (actual-ai)
ACTUAL_PASSWORD=your_actual_server_password
ACTUAL_BUDGET_ID=your_budget_sync_id

# Backups (backup/backup.sh) - restic + rclone Google Drive. No quotes around values.
RESTIC_PASSWORD=long_random_string_keep_in_password_manager
RCLONE_CONFIG_GDRIVE_TYPE=drive
RCLONE_CONFIG_GDRIVE_SCOPE=drive.file
# your own Google OAuth Desktop client (see backup/README.md) - rclone's shared one is rate limited
RCLONE_CONFIG_GDRIVE_CLIENT_ID=xxxx.apps.googleusercontent.com
RCLONE_CONFIG_GDRIVE_CLIENT_SECRET=xxxx
RCLONE_CONFIG_GDRIVE_TOKEN=paste_output_of_rclone_authorize_(base64_or_json)
