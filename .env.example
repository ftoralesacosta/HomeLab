# Cloudflare Configuration
Cloudflare_API_KEY=your_api_key_here

# Wireguard Configuration
WIREGUARD_PRIVATE_KEY=your_private_key_here

# Authelia: Gmail app password for verification/reset emails (smtp.gmail.com:587)
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# CoreWeave / W&B Inference (Open WebUI, Hermes via systemd/hermes-env.service)
COREWEAVE_API_BASE=https://api.inference.wandb.ai/v1
COREWEAVE_API_KEY=your_coreweave_api_key_here

# Open WebUI
WEBUI_SECRET_KEY=openssl_rand_hex_32
OAUTH_CLIENT_SECRET=authelia_oidc_client_secret_plaintext
# Hermes API server key (Open WebUI client + Hermes API_SERVER_KEY via systemd/hermes-env.service)
HERMES_API_KEY=openssl_rand_hex_32

# General / other services
DOMAIN_NAME=example.com
DOCKERDIR=/home/you/.volumes
WIREGUARD_ADDRESS=10.2.0.2/32
SEARXNG_SECRET=openssl_rand_hex_32

# Actual Budget (actual-ai)
ACTUAL_PASSWORD=your_actual_server_password
ACTUAL_BUDGET_ID=your_budget_sync_id
ACTUAL_OPENID_CLIENT_SECRET=authelia_oidc_client_secret_plaintext_for_actual

# Backups (backup/backup.sh) - restic + rclone Google Drive. No quotes around values.
RESTIC_PASSWORD=long_random_string_keep_in_password_manager
RCLONE_CONFIG_GDRIVE_TYPE=drive
RCLONE_CONFIG_GDRIVE_SCOPE=drive.file
# your own Google OAuth Desktop client (see backup/README.md) - rclone's shared one is rate limited
RCLONE_CONFIG_GDRIVE_CLIENT_ID=xxxx.apps.googleusercontent.com
RCLONE_CONFIG_GDRIVE_CLIENT_SECRET=xxxx
RCLONE_CONFIG_GDRIVE_TOKEN=paste_output_of_rclone_authorize_(base64_or_json)

# Nginx Proxy Manager admin login (nginx-proxy-manager/add-host.sh CLI; UI http://192.168.4.51:81)
NPM_ADMIN_EMAIL=your_npm_admin_email
# Leave NPM_ADMIN_PASSWORD unset: the script prompts for it (hidden input).
# Set it only for non-interactive/scripted use.
# NPM_ADMIN_PASSWORD=your_npm_admin_password
# Optional - LE email defaults to NPM_ADMIN_EMAIL; API URL defaults to http://127.0.0.1:81/api
# NPM_LE_EMAIL=
# NPM_API_URL=

# --- Music downloads (slskd / Soulseek) ---------------------------------------
# slskd rides the main `vpn` gluetun (same WireGuard key as qbittorrent) and
# reads its forwarded port from gluetun's control server, which is protected by
# this key (openssl rand -hex 32).
GLUETUN_CONTROL_API_KEY=openssl_rand_hex_32

# Soulseek has no signup: pick any free username + a password; the account is
# created automatically on first login.
SLSKD_SLSK_USERNAME=whatever_you_want
SLSKD_SLSK_PASSWORD=pick_a_password
# slskd's own web login is disabled (SLSKD_NO_AUTH in compose): the Authelia gate
# via NPM is the login, mirroring the *arrs' "External" auth. The API key is still
# used by the Lidarr slskd plugin over proxy-net.
SLSKD_API_KEY=openssl_rand_hex_32

# Local Deep Research service account (Open WebUI Deep Research model, MCP).
# Created once in LDR; open-webui/functions/install.sh copies it into the function's valves.
DEEP_RESEARCH_USER=openwebui
DEEP_RESEARCH_PASSWORD=long-random-password
